{
    "extends": "./tsconfig.build.json",
    "compilerOptions": {
        "target": "es2022",
        "allowJs": true,
        "composite": false,
        "noEmit": true,
        "types": ["node"],
        "paths": {
            "parse5": ["./packages/parse5/lib/index.ts"],
            "parse5-*": ["./packages/parse5-*/lib/index.ts"],
            "parse5-test-utils/utils/*": ["./test/utils/*"]
        }
    },
    "include": ["*.js", "*.ts", "bench", "packages", "scripts", "test/utils"],
    "exclude": ["**/dist"]
}
